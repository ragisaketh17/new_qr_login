# Database Configuration (XAMPP MySQL / MariaDB)
# Default XAMPP settings: host=localhost, port=3306, user=root, password is empty
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mart_loyalty

# Full connection string alternative:
DATABASE_URL=mysql://root:@localhost:3306/mart_loyalty

# Dashboard Admin Credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

# Timezone offset in minutes (330 = UTC+5:30 for India IST)
DASHBOARD_UTC_OFFSET_MINUTES=330

# Optional Server Settings
PORT=3000
VISIT_COOLDOWN_MINUTES=0
PUBLIC_URL=

# Google Sign-in & Social links
GOOGLE_CLIENT_ID=
GOOGLE_REVIEW_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
SITE_URL=
