# Database Configuration (XAMPP MySQL / MariaDB)
# Default XAMPP settings: host=localhost, port=3306, user=root, password is empty
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mart_loyalty

# Full connection string alternative:
DATABASE_URL=mysql://root:@localhost:3306/mart_loyalty

# Dashboard Admin Credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

# Timezone offset in minutes (330 = UTC+5:30 for India IST)
DASHBOARD_UTC_OFFSET_MINUTES=330

# Optional Server Settings
PORT=3000
VISIT_COOLDOWN_MINUTES=0
PUBLIC_URL=

# SMTP Email Configuration (Gmail App Password or SMTP provider)
# If using Gmail:
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Generate an App Password (16 characters) under Security -> App Passwords
# 3. Paste your email in SMTP_USER and the 16-character password in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Bombay Chaat Bhandar" <your-email@gmail.com>
SMTP_SECURE=false

# Google Review & Social links
GOOGLE_REVIEW_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
SITE_URL=
